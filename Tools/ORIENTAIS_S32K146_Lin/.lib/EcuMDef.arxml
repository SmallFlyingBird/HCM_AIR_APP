										</ECUC-REFERENCE-DEF>
									</REFERENCES>
									<SUB-CONTAINERS>
										<!-- Container Definition: EcuMAlarmClock -->
										<ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:750dd6de-13ec-48cf-befd-615fde9145b3">
