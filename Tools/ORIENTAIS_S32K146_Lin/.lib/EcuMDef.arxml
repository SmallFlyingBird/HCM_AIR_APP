										<!-- Container Definition: EcuMDriverInitListOne -->
										<ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:e108fe98-dc5c-4f3c-9d9e-5a4989fb20d0">
											<SHORT-NAME>EcuMDriverInitListOne</SHORT-NAME>
											<DESC>
												<L-2 L="EN">Container for Init Block I.</L-2>
											</DESC>
											<INTRODUCTION>
												<P>
													<L-1 L="EN">This container holds a list of module IDs that will be initialized. Each module in the list will be called for initialization in the list order.

                                                All modules in this list are initialized before the OS is started and so these modules require no OS support.</L-1>
												</P>
											</INTRODUCTION>
											<RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_EcuM_00111</RELATED-TRACE-ITEM-REF>
