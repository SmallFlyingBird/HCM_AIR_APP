													<LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
													<UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
													<REQUIRES-INDEX>true</REQUIRES-INDEX>
													<PARAMETERS>
														<!-- PARAMETER DEFINITION: EcuMModuleID -->
														<ECUC-STRING-PARAM-DEF UUID="ECUC:9536b7d4-b6c4-dd76-31c1-7ed9be298f6f">
															<SHORT-NAME>EcuMModuleID</SHORT-NAME>
															<ADMIN-DATA>
																<SDGS>
																	<SDG GID="iSoft::IdentifiableOptions">
																		<SD GID="CONTROL_NAME">Module ID</SD>
																		<SD GID="TRIGGER_FLAG">true</SD>
																		<SD GID="DERIVED_FLAG">true</SD>
																	</SDG>
																</SDGS>
															</ADMIN-DATA>
															<DESC>
																<L-2 L="EN">Short name of the module to be initialized, e.g. Mcu, Gpt etc.</L-2>
															</DESC>
															<INTRODUCTION>
																<P>
																	<L-1 L="EN">In case EcuMModuleRef is used the EcuMModuleID is optional (in case it is given it shall have the same value as the referenced module configuration).</L-1>
																</P>
															</INTRODUCTION>
															<RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_EcuM_00123</RELATED-TRACE-ITEM-REF>
