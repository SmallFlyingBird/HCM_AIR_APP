										</ECUC-SYMBOLIC-NAME-REFERENCE-DEF>
									</REFERENCES>
									<SUB-CONTAINERS>
										<ECUC-PARAM-CONF-CONTAINER-DEF UUID="ECUC:a83f64ee-812b-4e3b-b0d6-c4f289040010">
											<SHORT-NAME>EcuMDriverInitListThree</SHORT-NAME>
											<DESC>
												<L-2 L="EN">Container for Init Block III.</L-2>
											</DESC>
											<INTRODUCTION>
												<P>
													<L-1 L="EN">This container holds a list of module IDs that will be initialized. Each module in the list will be called for initialization in the list order.

                                                All modules in this list are initialized after the OS is started and so these modules may use OS support. These modules may also rely on the Nvram ReadAll job to have provided all data.</L-1>
												</P>
											</INTRODUCTION>
											<RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_EcuM_00112</RELATED-TRACE-ITEM-REF>
