														<SD GID="CONTROL_NAME">Normal McuMode Ref</SD>
													</SDG>
												</SDGS>
											</ADMIN-DATA>
											<DESC>
												<L-2 L="EN">This parameter is a reference to the normal MCU mode to be restored after a sleep.</L-2>
											</DESC>
											<RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_EcuM_00204</RELATED-TRACE-ITEM-REF>
											<LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
