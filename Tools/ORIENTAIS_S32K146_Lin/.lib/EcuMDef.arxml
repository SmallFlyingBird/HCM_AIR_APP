														<!-- PARAMETER DEFINITION: EcuMModuleService -->
														<ECUC-ENUMERATION-PARAM-DEF UUID="ECUC:a50143a0-bea2-df92-120c-54c216ca74f6">
															<SHORT-NAME>EcuMModuleService</SHORT-NAME>
															<ADMIN-DATA>
																<SDGS>
																	<SDG GID="iSoft::IdentifiableOptions">
																		<SD GID="CONTROL_NAME">Module Service</SD>
																	</SDG>
																</SDGS>
															</ADMIN-DATA>
															<DESC>
																<L-2 L="EN">The service to be called to initialize that module, e.g. Init, PreInit, Start etc. If nothing is defined "Init" is taken by default.</L-2>
															</DESC>
															<RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_EcuM_00224</RELATED-TRACE-ITEM-REF>
