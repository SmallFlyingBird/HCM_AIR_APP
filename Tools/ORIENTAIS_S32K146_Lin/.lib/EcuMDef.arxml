								</ECUC-BOOLEAN-PARAM-DEF>
								<!-- PARAMETER DEFINITION: EcuMResetLoopDetection -->
								<ECUC-BOOLEAN-PARAM-DEF UUID="ECUC:53a6ceed-b5cc-4bd4-8741-60747b77dd76">
									<SHORT-NAME>EcuMResetLoopDetection</SHORT-NAME>
									<ADMIN-DATA>
										<SDGS>
											<SDG GID="iSoft::IdentifiableOptions">
												<SD GID="CONTROL_NAME">Reset Loop Detection</SD>
											</SDG>
										</SDGS>
									</ADMIN-DATA>
									<DESC>
										<L-2 L="EN">If false, no reset loop detection is performed. If this configuration parameter exists and is set to true, the callout "EcuM_LoopDetection" is called during startup of EcuM (during StartPreOS).</L-2>
									</DESC>
									<RELATED-TRACE-ITEM-REF DEST="TRACEABLE">ECUC_EcuM_00171</RELATED-TRACE-ITEM-REF>
