                    <ECUC-NUMERICAL-PARAM-VALUE>
                      <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">/ZX_K14xM/Lin/LinGlobalConfig/LinChannel/LinHeaderTimeout</DEFINITION-REF>
