                    <ECUC-TEXTUAL-PARAM-VALUE>
                      <DEFINITION-REF DEST="ECUC-ENUMERATION-PARAM-DEF">/ZX_K14xM/Lin/LinGlobalConfig/LinChannel/LinNodeType</DEFINITION-REF>
                      <VALUE>SLAVE</VALUE>
